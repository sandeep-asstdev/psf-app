# ==============================================================================
# PSF (Post Service Follow-up) SaaS Platform Environment Configuration
# ==============================================================================

# --- Application ---
APP_NAME="PSF SaaS Platform"
APP_ENV="development" # development | staging | production
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="psf-super-secret-jwt-and-crypto-signing-key-change-in-production-min32chars"
API_V1_STR="/api/v1"
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# --- Database (PostgreSQL) ---
POSTGRES_USER="psf_admin"
POSTGRES_PASSWORD="psf_secure_password_dev"
POSTGRES_DB="psf_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://psf_admin:psf_secure_password_dev@localhost:5432/psf_db?schema=public"

# --- Redis (Cache, Sessions, Celery/ARQ queue, Pub/Sub) ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# --- Authentication & JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"
COOKIE_SECURE=false # Set to true in production (requires HTTPS)
COOKIE_SAMESITE="lax" # lax | strict | none
COOKIE_DOMAIN=""

# --- Storage (S3 / MinIO) ---
STORAGE_BACKEND="minio" # minio | s3
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_DOCUMENTS="psf-documents"
S3_BUCKET_EXPORTS="psf-exports"
S3_REGION="us-east-1"
S3_SECURE=false

# --- Frontend Environment Variables (Vite uses VITE_ prefix) ---
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_WS_BASE_URL="ws://localhost:8000/api/v1/ws"
VITE_APP_NAME="PSF - Post Service Follow-up"

# --- Background Worker & Scheduler ---
WORKER_CONCURRENCY=4
MAX_BULK_IMPORT_ROWS=50000

# --- Telephony / WhatsApp Mock or Real Webhooks ---
SMS_GATEWAY_PROVIDER="mock" # mock | twilio | gupshup | kaleyra
WHATSAPP_GATEWAY_PROVIDER="mock"
CALL_INTEGRATION_MODE="tel_deep_link" # tel_deep_link | cti_webhook
